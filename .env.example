# 复制为 .env 后再 docker compose。不要把填好的 .env 提交进 git。
# cp .env.example .env

# 大模型密钥（必填；二选一即可，入口会互相同步）
DEEPSEEK_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# 控制台登录（首次写入；登录后必须改密）
ATKBRAIN_ADMIN_USER=admin
ATKBRAIN_ADMIN_PASSWORD=admin

# 改密时设为 1。不要写成空：ATKBRAIN_ADMIN_PASSWORD_RESET= 会让容器起不来
# ATKBRAIN_ADMIN_PASSWORD_RESET=1

# 安全入口：空=本机 secrets 生成 8 位路径（不能在此指定字符串）。
# 仅本机 npm run dev 可关掉：ATKBRAIN_SECURITY_ENTRY=off
# ATKBRAIN_SECURITY_ENTRY=

# 监听。host 网络下 0.0.0.0 才能用局域网 IP 打开控制台
ATKBRAIN_HOST=0.0.0.0
ATKBRAIN_PORT=2333

# 浏览器走 :2334（入口会把 2334 转到 2333）。开 Cookie 后不要用 *
ATKBRAIN_CORS_ORIGINS=http://127.0.0.1:2334,http://localhost:2334,http://127.0.0.1:2333,http://localhost:2333

# Pi
ATKBRAIN_PI_BIN=pi
ATKBRAIN_PI_PROVIDER=deepseek
ATKBRAIN_PI_MODEL=deepseek-flash
# 进程闸（防孤儿堆到几百）。从者+工人默认每猎 4，整机 32
# ATKBRAIN_PI_MAX_LIVE=32
# ATKBRAIN_PI_PER_PROJECT=4
# ATKBRAIN_PI_WORKER_IDLE_SEC=180

# 会话：登录起算 24 小时，到期必须重新登录（不滑动续期）
# ATKBRAIN_SESSION_MAX_AGE_SEC=86400

# 可选：Pi / 脚本调 API 用的令牌（浏览器走登录会话，不必填）
# ATKBRAIN_API_TOKEN=

# Yakit。host 网络下与本机一样：自拉 11433，MITM 从 8084 起找空闲口
# ATKBRAIN_YAKIT_MCP_FULL_PORT=11433
# ATKBRAIN_YAKIT_MITM_PORT=8084
